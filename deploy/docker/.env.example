# Optional — copy to .env next to docker-compose.yml to override Compose defaults.
#   cp .env.example .env

# Host ports
API_HOST_PORT=8040
WEB_HOST_PORT=8050

# Shared by api + web
TIMEZONE=America/Cuiaba
LOG_LEVEL=INFO
TATUSCAN_OFFLINE_AFTER=2h
# UI / API message language (en or pt)
TATUSCAN_LANG=en

# Bearer token for API writes (POST/PATCH/DELETE). Empty = open writes.
# Set the same value on agents via client TATUSCAN_API_TOKEN.
# TATUSCAN_API_TOKEN=

# Optional image overrides
# API_IMAGE=carlosrabelo/tatuscan-api:latest
# WEB_IMAGE=carlosrabelo/tatuscan-web:latest
