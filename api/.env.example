# Optional — without this file the API uses the same defaults.
TATUSCAN_PORT=8040
# Local default is /tmp. In Docker/K8s set TATUSCAN_DB_DIR=/data (volume).
TATUSCAN_DB_DIR=/tmp
TATUSCAN_DB_FILE=tatuscan.db
# SQLALCHEMY_DATABASE_URI=sqlite:////tmp/tatuscan.db
TIMEZONE=America/Cuiaba
LOG_LEVEL=INFO
# API message language (en or pt)
TATUSCAN_LANG=en
# Bearer token for POST/PATCH/DELETE (optional; empty = open writes)
# TATUSCAN_API_TOKEN=
# Machines without check-in older than this are offline (default: 2h)
# TATUSCAN_OFFLINE_AFTER=2h
# Transitional: skip Flask/SQLAlchemy datetime rewrite on startup (default: migrate)
# TATUSCAN_SKIP_LEGACY_DATETIME_MIGRATE=1
