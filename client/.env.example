# Optional — without this file the client uses built-in defaults.
# Copy to .env only when you need to override them.

# Server URL (default: http://127.0.0.1:8040)
TATUSCAN_URL=http://127.0.0.1:8040

# Collection interval (optional) - Default: 15m
# Examples: 15m, 30s, 1h
TATUSCAN_INTERVAL=15m

# API bearer token (optional) — required when the API has TATUSCAN_API_TOKEN set
# TATUSCAN_API_TOKEN=

# Log level (optional) - Default: warn
# Options: debug, info, warn, error, fatal
TATUSCAN_LOG_LEVEL=warn